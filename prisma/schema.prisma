generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(cuid())
  fullName        String    @map("full_name") 
  email       String   @unique
  address     String  @default("")
  password    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  role        Role     @default(USER)
  isVerifiedEmail  Boolean  @default(false) @map("is_verified_email")

  @@map("users")
}

model Otp{
  id String @id @default(cuid())
  email       String 
  otpCode         String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  typeOtp     OtpType @map("type_otp")
  purposeOtp  OtpPurpose @map("purpose_otp")
  expiresAt   BigInt       // Thời gian hết hạn OTP
  @@map("otps")
}

model Category{
  id String @id @default(cuid())
  name String @unique
  imageUrl String @default("")
  description String @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("categories")
}

enum Role {
  ADMIN
  USER
}

enum OtpType {
  EMAIL
  PHONE
}

enum OtpPurpose {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
  CHANGE_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
}